# Пример окружения админ-бота. Скопировать в .env и заполнить.
# Секреты в git НЕ попадают (.gitignore).

# --- Telegram (бот владельца) ---
ADMINBOT_TG_TOKEN=            # токен из BotFather для отдельного админ-бота
ADMINBOT_OWNER_TG_ID=         # Telegram id владельца; всем остальным бот отвечает отказом
# На российском сервере имя api.telegram.org не разрешается в адрес, хотя сами адреса
# доступны. Список берётся из настроек рабочего бота; пусто — обычный путь (для ноутбука).
TELEGRAM_API_IPS=149.154.167.220,149.154.167.91,149.154.166.110,91.108.4.200,91.108.56.130

# --- Базы данных ---
# БД рабочего бота: пользователь ТОЛЬКО с правом чтения (SELECT на схему public)
BOT_DB_DSN=postgresql://USER:PASSWORD@HOST:5432/clients_db
# Своё хранилище (схема adminbot). Если не задано — используется BOT_DB_DSN.
ADMINBOT_DB_DSN=

# --- amoCRM ---
AMO_BASE_URL=https://raketacleancrm.amocrm.ru
AMO_TOKEN=                    # долгосрочный токен интеграции С ПРАВОМ ЗАПИСИ

# --- Функция amo_sync (выключатели) ---
AMO_SYNC_ENABLED=0            # 1 — функция работает, 0 — выключена (kill switch)
AMO_SYNC_DRY_RUN=1            # 1 — репетиция: решения принимаем, в амо НЕ пишем

# --- Кто какие работы делает (поле «Услуга» в сделке) ---
# Робот ставит «Услугу», только если она пустая. Значения: furniture (Чистка мебели),
# cleaning (Уборка). Новый мастер добавляется сюда — код править не нужно.
SERVICE_BY_MASTER=Никита:furniture,Дмитрий:furniture,Дима:furniture,Ольга:cleaning,Оля:cleaning

# --- Режим работы (значения по умолчанию можно не задавать) ---
AMO_SYNC_BACKLOG_FROM=2026-08-21      # с какой даты разбирать хвост непроведённых заказов
AMO_SYNC_RECONCILE_HOUR_MSK=21        # час вечерней сверки по Москве
AMO_SYNC_SALESBOT_WAIT_SEC=2400       # сколько ждать автосделку сейлзбота, секунд
                                      # (амо подтормаживает, бывают задержки до 20 минут)
AMO_SYNC_POLL_INTERVAL_SEC=60         # как часто смотреть в БД бота, секунд

# --- Уборки клининг-контура ---
# Уборки рабочий бот пишет в СВОЮ таблицу (public.cleaning_orders), поэтому
# у них свой поток и свой выключатель. «Услуга» всегда «Уборка», «Специалист»
# всегда Ольга; бригадир уходит в примечание (решение владельца 2026-09-10).
CLEANING_SYNC_ENABLED=0       # 1 — робот проводит уборки в amoCRM
CLEANING_SYNC_DRY_RUN=1       # 1 — репетиция: решения принимаем, в амо НЕ пишем
CLEANING_BACKLOG_FROM=        # с какой даты проводить; пусто — со дня включения
                              # (старые уборки владелец закрывает сам)

# --- Ковры от партнёра «Кристалл» (этап 3) ---
CARPETS_ENABLED=0             # 1 — робот разбирает отчёты партнёра из почты
CARPETS_DRY_RUN=1             # 1 — репетиция: решения принимаем, в амо НЕ пишем
CARPETS_POLL_INTERVAL_SEC=3600  # как часто смотреть почту (отчёты приходят раз в неделю)
CARPETS_MAX_ROWS=100          # больше наших строк в письме — письмо откладывается
                              # (недельный отчёт 5–15 строк, месячный до 50)

# Почтовый ящик робота: только чтение, отправлять письма он не умеет.
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_USER=                    # ящик, куда пересылаются письма партнёра
MAIL_APP_PASSWORD=            # пароль приложения (не основной пароль от почты)
MAIL_FOLDER=robot_amo         # папка, которую смотрит робот

# --- Google Календарь (этап 2) ---
GCAL_ENABLED=0                # 1 — робот оформляет сделки по записям календаря
GCAL_DRY_RUN=1                # 1 — репетиция: решения принимаем, в амо НЕ пишем
GCAL_POLL_INTERVAL_SEC=300    # как часто спрашивать Google об изменениях, секунд
GCAL_SERVICE_ACCOUNT_FILE=~/.gcal.json   # ключ служебного аккаунта (docs/gcal_access.md)
# Календарей может быть несколько: мебель и ковры ведут мастера в основном,
# уборки — бригадир в своём. Перечисляются через запятую БЕЗ ПРОБЕЛОВ: скрипт
# обновления переносит настройки в окружение службы через xargs, и пробел внутри
# значения разорвал бы строку на две. Первый календарь — основной: ему достаётся
# закладка обмена, снятая до того, как календарей стало несколько.
GCAL_CALENDAR_ID=raketaclean52@gmail.com
GCAL_SYNC_FROM=               # с какой даты читать; пусто — со дня включения

# --- Автозвонок по заявке с сайта (autocall) ---
AUTOCALL_ENABLED=0            # 1 — робот обзванивает заявки с сайта, 0 — выключено (kill switch)
AUTOCALL_DRY_RUN=1            # 1 — репетиция: решения принимаем, НЕ звоним и НЕ пишем
AUTOCALL_POLL_INTERVAL_SEC=30 # как часто смотреть новые заявки, секунд (заявка остывает за минуты)
AUTOCALL_WINDOW_FROM=10       # с какого часа можно звонить клиенту (по Москве)
AUTOCALL_WINDOW_TO=20         # до какого часа можно звонить (по Москве); сам час не входит:
                              # ровно в 20:00 звонок уже уезжает на завтра 10:00

# АТС (onlinePBX): обязательны только при включённой функции.
PBX_BASE_URL=                 # адрес API АТС
PBX_API_KEY=                  # ключ API АТС
# Телефоны менеджера через запятую, без пробелов: сначала рабочий, потом личный.
# Мобильные, а НЕ внутренний номер АТС: переадресация внутреннего номера к
# звонкам через API не применяется (стенд 2026-09-02, см. docs/deploy.md).
PBX_MANAGER_DIAL=             # например: 89301112233,89864445566

# Уведомление менеджеру уходит от рабочего бота, с которым он уже работает.
WORKER_TG_TOKEN=              # токен рабочего бота (из BotFather)
MANAGER_TG_CHAT_ID=           # Telegram id чата менеджера

# --- Пульс админ-бота (оповещения, задача 6) ---
# Раз в минуту отмечается «я жив» в notify.service_heartbeats (не в
# public.service_heartbeats — туда этому боту писать нельзя, хард-правило).
# По умолчанию выключен — включается вместе со сторожем службы оповещений
# (raketa-notify).
HEARTBEAT_ENABLED=0
HEARTBEAT_INTERVAL_SEC=60
