# Пример окружения службы-почтальона (raketa-notify). Скопировать в .env и
# заполнить. Секреты в git не попадают (см. корневой .gitignore: .env, .env.*).

# --- База данных ---
# Своя роль службы (полный доступ к схеме notify), не bot и не adminbot —
# её заводит владелец или админ руками (агент за паролями не ходит).
NOTIFY_DB_DSN=postgresql://notify:ПАРОЛЬ@127.0.0.1:5432/clients_db

# --- Токены ботов, которые почтальон использует только на отправку ---
# Рабочий и админ-бот — уже существующие боты, их токены просто копируются
# сюда из их собственных .env. My_admin — новый бот, владелец создаёт и даёт
# токен (см. «Примечание владельцу» в ТЗ).
WORKER_TG_TOKEN=
ADMINBOT_TG_TOKEN=
MY_ADMIN_TG_TOKEN=

# --- Выключатель и репетиция ---
NOTIFY_ENABLED=0              # 1 — служба отправляет; 0 — поднимается и молчит (kill switch)
NOTIFY_DRY_RUN=1              # 1 — репетиция: логирует, что отправила бы, ящик не трогает

# --- Режим работы ---
NOTIFY_POLL_INTERVAL_SEC=60   # как часто заглядывать в ящик, секунд
NOTIFY_BATCH_LIMIT=20         # сколько созревших событий забирать за один проход

# --- Переходник журнала (задача 5) ---
# Свой выключатель, отдельно от NOTIFY_ENABLED: читает journalctl обоих
# ботов и кладёт в notify.outbox (kind=notify.journal, tech_journal),
# доставляет всё тот же почтальон. По умолчанию ВЫКЛЮЧЕН (правило проекта).
NOTIFY_JOURNAL_ENABLED=0                # 1 — читает journalctl и кладёт в ящик; 0 — молчит
NOTIFY_JOURNAL_POLL_INTERVAL_SEC=60     # как часто заглядывать в journalctl, секунд
NOTIFY_JOURNAL_MAX_PER_MINUTE=20        # потолок строк за один проход (при 60 сек — на минуту)

# --- Номера чатов по адресам справочника notify.routes.address ---
# Пустой адрес просто не используется: если справочник на него сослался,
# почтальон откладывает событие и громко пишет в свой журнал, а не падает.
# Какой бот пишет в какой адрес — см. notifyd/main.py: ADDRESS_SENDER_ALIAS.
WORK_CHAT_ID=                 # рабочие чаты (эта служба сегодня туда не пишет — второе ТЗ)
OPS_FEED_CHAT_ID=              # операционная лента — нынешний чат логов, со звуком
TECH_JOURNAL_CHAT_ID=          # технический журнал — НОВЫЙ чат, без звука (см. «Примечание владельцу»)
MY_ASSISTANT_CHAT_ID=          # тревоги по делам конторы — это и есть текущий бот админ-бота
MY_ADMIN_CHAT_ID=              # тревоги по технике — НОВЫЙ бот (см. «Примечание владельцу»)
MANAGER_CHAT_ID=               # чат менеджера

# Дорога до Telegram — та же, что у обоих ботов: с боевого VPS имя api.telegram.org
# не разрешается. Значения копируются из .env рабочего бота.
TELEGRAM_API_IPS=
TELEGRAM_PROXY_URL=
