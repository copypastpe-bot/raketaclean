# Пример окружения службы-почтальона (raketa-notify). Скопировать в .env и
# заполнить. Секреты в git не попадают (см. корневой .gitignore: .env, .env.*).

# --- База данных ---
# Своя роль службы (полный доступ к схеме notify), не bot и не adminbot —
# её заводит владелец или админ руками (агент за паролями не ходит).
NOTIFY_DB_DSN=postgresql://notify:ПАРОЛЬ@127.0.0.1:5432/clients_db

# --- Токены ботов, которые почтальон использует только на отправку ---
# Рабочий и админ-бот — уже существующие боты, их токены просто копируются
# сюда из их собственных .env. My_admin — новый бот, владелец создаёт и даёт
# токен (см. «Примечание владельцу» в ТЗ).
WORKER_TG_TOKEN=
ADMINBOT_TG_TOKEN=
MY_ADMIN_TG_TOKEN=

# --- Выключатель и репетиция ---
# 1 — служба отправляет; 0 — поднимается и молчит (kill switch)
NOTIFY_ENABLED=0
# 1 — репетиция: логирует, что отправила бы, ящик не трогает
NOTIFY_DRY_RUN=1

# --- Режим работы ---
# как часто заглядывать в ящик, секунд
NOTIFY_POLL_INTERVAL_SEC=60
# сколько созревших событий забирать за один проход
NOTIFY_BATCH_LIMIT=20

# --- Переходник журнала (задача 5) ---
# Свой выключатель, отдельно от NOTIFY_ENABLED: читает journalctl обоих
# ботов и кладёт в notify.outbox (kind=notify.journal, tech_journal),
# доставляет всё тот же почтальон. По умолчанию ВЫКЛЮЧЕН (правило проекта).
# 1 — читает journalctl и кладёт в ящик; 0 — молчит
NOTIFY_JOURNAL_ENABLED=0
# как часто заглядывать в journalctl, секунд
NOTIFY_JOURNAL_POLL_INTERVAL_SEC=60
# потолок строк за один проход (при 60 сек — на минуту)
NOTIFY_JOURNAL_MAX_PER_MINUTE=20

# --- Номера чатов по адресам справочника notify.routes.address ---
# Пустой адрес просто не используется: если справочник на него сослался,
# почтальон откладывает событие и громко пишет в свой журнал, а не падает.
# Какой бот пишет в какой адрес — см. notifyd/main.py: ADDRESS_SENDER_ALIAS.
# рабочие чаты (эта служба сегодня туда не пишет — второе ТЗ)
WORK_CHAT_ID=
# операционная лента — нынешний чат логов, со звуком
OPS_FEED_CHAT_ID=
# технический журнал — НОВЫЙ чат, без звука (см. «Примечание владельцу»)
TECH_JOURNAL_CHAT_ID=
# тревоги по делам конторы — это и есть текущий бот админ-бота
MY_ASSISTANT_CHAT_ID=
# тревоги по технике — НОВЫЙ бот (см. «Примечание владельцу»)
MY_ADMIN_CHAT_ID=
# чат менеджера
MANAGER_CHAT_ID=

# Дорога до Telegram — та же, что у обоих ботов: с боевого VPS имя api.telegram.org
# не разрешается. Значения копируются из .env рабочего бота.
TELEGRAM_API_IPS=
TELEGRAM_PROXY_URL=

# --- Сторож (задача 7) ---
# Свой выключатель, отдельно от NOTIFY_ENABLED и NOTIFY_JOURNAL_ENABLED. По
# «Порядку выката» ТЗ включается вместе с пульсом ботов (задача 6), позже
# переходника журнала. Определяет только «сломано/работает» — инциденты
# (задача 8) пока не открывает и не закрывает.
# 1 — проверяет; 0 — молчит
NOTIFY_WATCHDOG_ENABLED=0
# как часто прогонять все проверки
NOTIFY_WATCHDOG_POLL_INTERVAL_SEC=60
# пульс любого из трёх ботов старше — «сломано»
NOTIFY_WATCHDOG_HEARTBEAT_MAX_AGE_SEC=300
# опрос amoCRM не двигался дольше — «сломано»
NOTIFY_WATCHDOG_AMOCRM_MAX_AGE_SEC=300
# таймаут проверки «база отвечает»
NOTIFY_WATCHDOG_DB_TIMEOUT_SEC=5
# таймаут проверки «прокси отвечает» (getMe)
NOTIFY_WATCHDOG_PROXY_TIMEOUT_SEC=5
# рассыльщик клиентам: возраст последней отправки
NOTIFY_WATCHDOG_DISPATCH_MAX_AGE_SEC=1800

# Приём нажатий кнопки «сел разбираться» и команды /status в боте My_admin.
# Без этих двух строк кнопка нарисуется, но нажимать её будет некому:
# красная тревога продолжит приходить каждые 10 минут — ночью (00:00-08:00 МСК)
# одним сообщением за ночь (ревью 18.09 замечание 1, ночная пауза — решение 19.09).
# 1 — служба слушает бота My_admin
NOTIFY_MY_ADMIN_ENABLED=0
# Telegram id владельца: только он управляет инцидентами
MY_ADMIN_OWNER_TG_ID=
