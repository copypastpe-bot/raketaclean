# Выключатели службы оповещений. Секретов здесь нет и быть не должно —
# только «включено / выключено». Файл лежит на сервере как
# /opt/raketa-notify/switches.env, принадлежит admin:admin с правами 644,
# и правится без sudo: шаги выката ведёт агент, токены остаются в .env.
#
# Решение владельца 21.09: так делаем всегда и во всех службах проекта.
#
# После правки — перезапуск: sudo systemctl restart raketa-notify.service
# Порядок включения и что смотреть после каждого шага — docs/runbook.md, раздел 5.

# --- Шаг 1-2: почтальон ---
# 1 — служба отправляет; 0 — поднимается и молчит (главный рубильник)
NOTIFY_ENABLED=0
# 1 — репетиция: пишет в журнал, что отправила бы, и не трогает ящик
NOTIFY_DRY_RUN=1

# --- Шаг 3: технический журнал ---
# 1 — читает journalctl обеих служб и кладёт записи в технический чат
NOTIFY_JOURNAL_ENABLED=0

# --- Шаг 5: сторож ---
# 1 — семь проверок раз в минуту, результат в журнал службы
# Включать ТОЛЬКО после пульса ботов (шаг 4), иначе поймает ложные поломки
NOTIFY_WATCHDOG_ENABLED=0

# --- Шаг 6: тревоги ---
# 1 — поломки становятся инцидентами с напоминаниями
NOTIFY_INCIDENTS_ENABLED=0
# 1 — служба слушает бота My_admin: кнопка «сел разбираться» и /status
# Без него кнопка нарисуется, но нажимать её будет некому
NOTIFY_MY_ADMIN_ENABLED=0
