[Unit]
Description=Raketa Notify (служба-почтальон оповещений)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=notify
Group=notify
WorkingDirectory=/opt/raketa-notify/app
# Два файла настроек, и это осознанно (решение владельца 21.09):
#   .env          — секреты (токены, пароль базы), правит только владелец, root:notify 640;
#   switches.env  — выключатели шагов выката, секретов нет, правит агент, admin:admin 644.
# Порядок важен: второй файл перекрывает первый, поэтому выключатель из
# switches.env выигрывает у случайно оставшегося в .env. Минус перед путём —
# «файла может не быть»: служба поднимется и со старой раскладкой.
EnvironmentFile=/opt/raketa-notify/.env
EnvironmentFile=-/opt/raketa-notify/switches.env
ExecStart=/opt/raketa-notify/.venv/bin/python -m notifyd.main
Restart=always
RestartSec=5s

# Переходник журнала (задача 5) читает journalctl обоих ботов. Членство в
# systemd-journal — стандартный способ читать чужой журнал без root (см.
# journalctl(1), «Access Control»); группа существует на любом systemd-хосте
# сама по себе, ничего заводить отдельно не нужно.
SupplementaryGroups=systemd-journal

# Сервис пишет во внешние Telegram-чаты, поэтому прав на сервере ему нужно
# как можно меньше (тот же приём, что у raketa-admin-bot.service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# Postgres на этом сервере без TLS: иначе asyncpg пробует SSL и падает.
Environment=PGSSLMODE=disable

[Install]
WantedBy=multi-user.target
